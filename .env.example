# ============================================
# Leve — Variáveis de Ambiente (Template)
# Copie este arquivo para .env e preencha
# com as suas credenciais.
# ============================================

# Firebase Web
# Obtenha em: Firebase Console > Configurações do projeto > Apps > Web
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=

# Firebase Android
# Obtenha em: Firebase Console > Configurações do projeto > Apps > Android
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_PROJECT_ID=
FIREBASE_ANDROID_STORAGE_BUCKET=

# RevenueCat
# Obtenha em: RevenueCat Dashboard > API Keys
REVENUECAT_ANDROID_API_KEY=
REVENUECAT_ENTITLEMENT_ID=
